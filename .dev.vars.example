# The three settings the relay needs. Every value below is a placeholder the relay refuses until you replace it.
# The real values go in Cloudflare, never in this file.
NORMAIL_SIGNING_SECRET=REPLACE-ME-paste-the-signing-secret-from-normail
CLAUDE_TRIGGER_URL=REPLACE-ME-paste-the-trigger-address-from-claude
CLAUDE_TRIGGER_TOKEN=REPLACE-ME-paste-the-trigger-token-from-claude
